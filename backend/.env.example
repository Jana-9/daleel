# Copy to backend/.env and adjust. Never commit the real .env file.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/daleel

# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=1440

# Set to true in production (HTTPS only).
COOKIE_SECURE=false
