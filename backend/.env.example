# Copy to backend/.env and adjust. Never commit the real .env file.

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/daleel

# Generate a long random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=1440

# Set to true in production (HTTPS only).
COOKIE_SECURE=false

# Uploaded files (relative to backend/)
STORAGE_DIR=storage
MAX_UPLOAD_MB=20
MAX_PAGES=500

# Embeddings: "local" downloads a free multilingual model (~220 MB) on first use.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Chunk size in characters; keep under the model's 128-token limit (~450 Arabic characters).
CHUNK_SIZE=450
CHUNK_OVERLAP=90

# Background worker. true = runs inside the API (simplest for development).
# In production set false and run: uv run python -m app.worker
RUN_WORKER_IN_API=true
